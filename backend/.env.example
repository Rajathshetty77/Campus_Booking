# Copy to backend/.env and fill in.

# --- Database (Supabase Postgres) ---
# Supabase dashboard → Connect → "Session pooler" connection string, with your database password filled in.
# URL-encode special characters in the password (e.g. @ → %40, # → %23).
DATABASE_URL=postgresql://postgres:Magicnitro01$@db.sgtcxdtaidsgegzafqhb.supabase.co:5432/postgres
# DB_POOL_SIZE=5

# Accounts that get admin rights (approve bookings, manage venues). Comma separated.
ADMIN_EMAILS=admin@nmamit.in

# Email domains allowed to sign in (exact match on the part after @).
ALLOWED_DOMAINS=nmamit.in,nitte.edu.in

# --- AI assistant (Claude) ---
# Without a key the assistant falls back to a built-in rule-based parser.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_DISABLED=true

# Set to "production" on a real server: marks the session cookie Secure (requires HTTPS).
ENV=development
